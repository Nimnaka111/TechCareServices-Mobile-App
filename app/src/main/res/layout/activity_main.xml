<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TechCare Services"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A73E8"
            android:layout_gravity="center"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What do you need help with today?"
            android:textSize="16sp"
            android:layout_gravity="center"
            android:layout_marginBottom="25dp"
            android:textColor="#5F6368"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <Button
                android:id="@+id/btn_ac_service"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:text="AC Repair"
                android:backgroundTint="#FFFFFF"
                android:textColor="#202124"
                android:elevation="4dp"/>

            <Button
                android:id="@+id/btn_laptop_service"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:text="Laptop Repair"
                android:backgroundTint="#FFFFFF"
                android:textColor="#202124"
                android:elevation="4dp"/>

            <Button
                android:id="@+id/btn_tv_service"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:text="TV Repair"
                android:backgroundTint="#FFFFFF"
                android:textColor="#202124"
                android:elevation="4dp"/>

            <Button
                android:id="@+id/btn_phone_service"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:text="Phone Repair"
                android:backgroundTint="#FFFFFF"
                android:textColor="#202124"
                android:elevation="4dp"/>
        </GridLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DADCE0"
            android:layout_marginVertical="20dp"/>

        <Button
            android:id="@+id/btn_go_to_track"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="TRACK MY REQUESTS"
            android:backgroundTint="#FBBC04"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_go_to_support"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="SUPPORT &amp; FAQ"
            android:backgroundTint="#34A853"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_back_to_login"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="LOGOUT"
            android:backgroundTint="#5F6368"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"/>

    </LinearLayout>
</ScrollView>