<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_booking_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Booking Service"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2196F3"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Service Type:"/>

        <RadioGroup
            android:id="@+id/rg_delivery_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="10dp">

            <RadioButton
                android:id="@+id/rb_home_pickup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home Pick Up"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rb_drop_off"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drop Off"
                android:layout_marginStart="20dp"/>
        </RadioGroup>

        <EditText
            android:id="@+id/et_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Home Address for Pick Up"
            android:padding="12dp"
            android:layout_marginBottom="15dp"
            android:visibility="visible"/>

        <EditText
            android:id="@+id/et_issue_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Describe the issue..."
            android:lines="3"
            android:gravity="top"
            android:layout_marginBottom="15dp"/>

        <DatePicker
            android:id="@+id/booking_date_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:datePickerMode="spinner"
            android:calendarViewShown="false" />

        <Button
            android:id="@+id/btn_submit_booking"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="SUBMIT REQUEST"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/btn_back_to_services"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back to Services"
            android:textSize="12sp"
            android:backgroundTint="#9E9E9E"/>

    </LinearLayout>
</ScrollView>